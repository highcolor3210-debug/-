{
  "format_version": "1.21.60",
  "minecraft:entity": {
    "description": {
      "identifier": "na:mage",
      "is_spawnable": true,
      "is_summonable": true,
      "spawn_category": "monster",
      "properties": {
        "na:casting": { "type": "bool", "default": false, "client_sync": true }
      }
    },
    "components": {
      "minecraft:type_family": { "family": ["na_mage", "monster", "mob"] },
      "minecraft:health": { "value": 24, "max": 24 },
      "minecraft:experience_reward": { "on_death": "query.last_hit_by_player ? 10 : 0" },
      "minecraft:collision_box": { "width": 0.6, "height": 1.9 },
      "minecraft:movement": { "value": 0.25 },
      "minecraft:movement.basic": {},
      "minecraft:navigation.walk": { "can_path_over_water": true, "can_open_doors": true, "avoid_damage_blocks": true },
      "minecraft:jump.static": {},
      "minecraft:can_climb": {},
      "minecraft:physics": {},
      "minecraft:pushable": { "is_pushable": true, "is_pushable_by_piston": true },
      "minecraft:breathable": { "total_supply": 15, "suffocate_time": 0 },
      "minecraft:nameable": {},
      "minecraft:despawn": { "despawn_from_distance": {} },
      "minecraft:equip_item": {},
      "minecraft:hurt_on_condition": {
        "damage_conditions": [
          { "filters": { "test": "in_lava", "subject": "self" }, "cause": "lava", "damage_per_tick": 4 }
        ]
      },

      "minecraft:behavior.float": { "priority": 0 },
      "minecraft:behavior.hurt_by_target": { "priority": 1 },
      "minecraft:behavior.nearest_attackable_target": {
        "priority": 2,
        "must_see": true,
        "reselect_targets": true,
        "within_radius": 18,
        "entity_types": [
          { "filters": { "test": "is_family", "subject": "other", "value": "player" }, "max_dist": 18 }
        ]
      },
      "minecraft:behavior.avoid_mob_type": {
        "priority": 3,
        "entity_types": [
          {
            "filters": { "test": "is_family", "subject": "other", "value": "player" },
            "max_dist": 5,
            "walk_speed_multiplier": 1.0,
            "sprint_speed_multiplier": 1.15
          }
        ]
      },
      "minecraft:behavior.look_at_player": { "priority": 4, "look_distance": 18, "probability": 1.0 },
      "minecraft:behavior.random_stroll": { "priority": 6, "speed_multiplier": 0.8 },
      "minecraft:behavior.random_look_around": { "priority": 7 }
    }
  }
}
