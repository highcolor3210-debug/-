{
  "format_version": "1.10.0",
  "render_controllers": {
    "controller.render.motion.player.third_person": {
      "geometry": "Geometry.default",
      "materials": [
        {
          "*": "Material.default"
        }
      ],
      "textures": [
        "Texture.default"
      ],
      "part_visibility": [
        {
          "*": true
        },
        {
          "helmet": "variable.helmet_layer_visible"
        },
        {
          "leftLegging": "variable.leg_layer_visible"
        },
        {
          "rightLegging": "variable.leg_layer_visible"
        },
        {
          "leftBoot": "variable.boot_layer_visible"
        },
        {
          "rightBoot": "variable.boot_layer_visible"
        },
        {
          "leftSock": "variable.boot_layer_visible && variable.leg_layer_visible"
        },
        {
          "rightSock": "variable.boot_layer_visible && variable.leg_layer_visible"
        },
        {
          "bodyArmor": "variable.chest_layer_visible"
        },
        {
          "leftArmArmor": "variable.chest_layer_visible"
        },
        {
          "rightArmArmor": "variable.chest_layer_visible"
        },
        {
          "belt": "variable.chest_layer_visible && variable.leg_layer_visible"
        },
        {
          "rightArm": "!v.motion_joints"
        },
        {
          "rightSleeve": "!v.motion_joints"
        },
        {
          "leftArm": "!v.motion_joints"
        },
        {
          "leftSleeve": "!v.motion_joints"
        },
        {
          "rightLeg": "!v.motion_joints"
        },
        {
          "rightPants": "!v.motion_joints"
        },
        {
          "leftLeg": "!v.motion_joints"
        },
        {
          "leftPants": "!v.motion_joints"
        }
      ]
    },
    "controller.render.motion.player.first_person": {
      "geometry": "Geometry.default",
      "materials": [
        {
          "*": "Material.default"
        }
      ],
      "textures": [
        "Texture.default"
      ],
      "part_visibility": [
        {
          "*": false
        },
        {
          "rightArm": "(query.get_equipped_item_name(0, 1) == '' || query.get_equipped_item_name(0, 1) == 'filled_map') && !v.motion_joints"
        },
        {
          "rightSleeve": "(query.get_equipped_item_name(0, 1) == '' || query.get_equipped_item_name(0, 1) == 'filled_map') && !v.motion_joints"
        },
        {
          "leftArm": "(query.get_equipped_item_name(0, 1) == 'filled_map' && query.get_equipped_item_name('off_hand') != 'shield') || (query.get_equipped_item_name('off_hand') == 'filled_map' && !query.item_is_charged) || (!query.item_is_charged && (variable.item_use_normalized > 0 && variable.item_use_normalized < 1.0))"
        },
        {
          "leftSleeve": "(query.get_equipped_item_name(0, 1) == 'filled_map' && query.get_equipped_item_name('off_hand') != 'shield') || (query.get_equipped_item_name('off_hand') == 'filled_map' && !query.item_is_charged) || (!query.item_is_charged && (variable.item_use_normalized > 0 && variable.item_use_normalized < 1.0))"
        }
      ]
    },
    "controller.render.motion.limbs.third_person": {
      "rebuild_animation_matrices": true,
      "geometry": "Geometry.motion_limbs",
      "materials": [
        {
          "*": "Material.default"
        }
      ],
      "textures": [
        "Texture.default"
      ],
      "part_visibility": [
        {
          "*": "v.motion_joints"
        }
      ]
    },
    "controller.render.motion.limbs.first_person": {
      "rebuild_animation_matrices": true,
      "geometry": "Geometry.motion_limbs",
      "materials": [
        {
          "*": "Material.default"
        }
      ],
      "textures": [
        "Texture.default"
      ],
      "part_visibility": [
        {
          "*": false
        },
        {
          "rightArm": "v.motion_joints && (query.get_equipped_item_name(0, 1) == '' || query.get_equipped_item_name(0, 1) == 'filled_map')"
        },
        {
          "rightForearm": "v.motion_joints && (query.get_equipped_item_name(0, 1) == '' || query.get_equipped_item_name(0, 1) == 'filled_map')"
        }
      ]
    }
  }
}
