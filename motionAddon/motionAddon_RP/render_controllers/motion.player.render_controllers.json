{
  "format_version": "1.10.0",
  "render_controllers": {
    "controller.render.motion.player.third_person": {
      "geometry": "Geometry.default",
      "materials": [
        {
          "*": "Material.default"
        }
      ],
      "textures": [
        "Texture.default"
      ],
      "part_visibility": [
        {
          "*": true
        },
        {
          "helmet": "variable.helmet_layer_visible"
        },
        {
          "leftLegging": "variable.leg_layer_visible"
        },
        {
          "rightLegging": "variable.leg_layer_visible"
        },
        {
          "leftBoot": "variable.boot_layer_visible"
        },
        {
          "rightBoot": "variable.boot_layer_visible"
        },
        {
          "leftSock": "variable.boot_layer_visible && variable.leg_layer_visible"
        },
        {
          "rightSock": "variable.boot_layer_visible && variable.leg_layer_visible"
        },
        {
          "bodyArmor": "variable.chest_layer_visible"
        },
        {
          "leftArmArmor": "variable.chest_layer_visible"
        },
        {
          "rightArmArmor": "variable.chest_layer_visible"
        },
        {
          "belt": "variable.chest_layer_visible && variable.leg_layer_visible"
        },
        {
          "rightArm": "!v.motion_joints"
        },
        {
          "rightSleeve": "!v.motion_joints"
        },
        {
          "leftArm": "!v.motion_joints"
        },
        {
          "leftSleeve": "!v.motion_joints"
        },
        {
          "rightLeg": "!v.motion_joints"
        },
        {
          "rightPants": "!v.motion_joints"
        },
        {
          "leftLeg": "!v.motion_joints"
        },
        {
          "leftPants": "!v.motion_joints"
        }
      ]
    },
    "controller.render.motion.limbs.third_person": {
      "rebuild_animation_matrices": true,
      "arrays": {
        "geometries": {
          "Array.motion_limbs": [
            "Geometry.motion_limbs",
            "Geometry.motion_limbs_slim"
          ]
        }
      },
      "geometry": "Array.motion_limbs[v.motion_slim]",
      "materials": [
        {
          "*": "Material.default"
        }
      ],
      "textures": [
        "Texture.default"
      ],
      "part_visibility": [
        {
          "*": "v.motion_joints"
        }
      ]
    }
  }
}
